# Copia este archivo como `.env` y rellena los valores reales.
# El `.env` real está en .gitignore: nunca se sube al repo.

# --- Modelo (Google Gemini vía langchain-google-genai) ---
# Clave de Google AI Studio. La lee la librería automáticamente.
GOOGLE_API_KEY=tu-google-api-key
# Modelo a usar. Ojo: gemini-3.5-flash-lite ignora `temperature`.
MODELO=gemini-3.5-flash-lite

# --- Memoria persistente (checkpointer de LangGraph) ---
# Cadena de conexión a Postgres. Si está, las conversaciones se guardan en la base
# (sobreviven a reinicios de Heroku). Si se deja vacía, se usa memoria RAM.
# En local va aquí; en Heroku va en Config Vars (lo pone el addon de Postgres).
DATABASE_URL=postgresql://usuario:password@host:5432/nombre_base

# --- Telegram ---
# Token del bot (lo da @BotFather).
TELEGRAM_TOKEN=123456:tu-token-de-telegram
# Secreto que Telegram manda en el header del webhook (lo eliges tú).
TELEGRAM_SECRET=cambiame
# URL pública de la app (base del webhook). En Heroku lleva sufijo aleatorio.
PUBLIC_URL=https://tu-app-xxxxxxxx.herokuapp.com
